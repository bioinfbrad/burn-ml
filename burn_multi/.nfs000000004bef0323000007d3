import pickle
import numpy as np
import matplotlib.pyplot as plt
import os
import sys
import time
import tensorflow as tf
from tensorflow.keras.callbacks import TensorBoard, EarlyStopping
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import (Conv2D, MaxPooling2D, Activation, 
                                     Dense, Dropout, BatchNormalization, Flatten)
from skopt import gp_minimize
from skopt.space import Real, Integer, Categorical
from skopt.utils import use_named_args

# Load data
data_dir = os.path.join(sys.argv[1], 'data')
with open(os.path.join(data_dir, "x.pickle"), "rb") as f:
    x = pickle.load(f)
with open(os.path.join(data_dir, "y.pickle"), "rb") as f:
    y = pickle.load(f)

# Calculate maximum conv layers
height, width = x.shape[1], x.shape[2]
min_dim = min(height, width)
max_conv_layers = 0
current_dim = min_dim

while current_dim > 1:
    current_dim = current_dim // 2
    max_conv_layers += 1

max_conv_layers_possible = max_conv_layers - 1
if max_conv_layers_possible < 3:
    raise ValueError(f"Input size {height}x{width} is too small for minimum 3 conv layers")

# Define hyperparameter space
max_dense_layers = 4
space = [
    Integer(3, max_conv_layers_possible, name='num_conv_layers'),
    Integer(1, max_dense_layers, name='num_dense_layers'),
    *[Integer(32, 256, name=f'conv{i+1}_filters') for i in range(max_conv_layers_possible)],
    *[Categorical([True, False], name=f'conv{i+1}_batchnorm') for i in range(max_conv_layers_possible)],
    *[Categorical(['same', 'valid'], name=f'conv{i+1}_padding') for i in range(max_conv_layers_possible)],
    *[Categorical([True, False], name=f'conv{i+1}_l2') for i in range(max_conv_layers_possible)],
    *[Integer(32, 256, name=f'dense{i+1}_units') for i in range(max_dense_layers)],
    *[Categorical([True, False], name=f'dense{i+1}_batchnorm') for i in range(max_dense_layers)],
    *[Real(0.0, 0.5, name=f'dense{i+1}_dropout') for i in range(max_dense_layers)],
    Real(1e-6, 1e-2, name='learning_rate'),
    Real(0.0, 0.5, name='global_dropout'),
    Integer(32, 128, name='batch_size')
]

# Optimization setup
k = 4
num_val_samples = len(x) // k
num_epochs = 100
early_stopping = EarlyStopping(patience=15, restore_best_weights=True)

@use_named_args(space)
def objective(**params):
    val_acc_list = []
    for i in range(k):
        # Data splitting
        val_data = x[i*num_val_samples:(i+1)*num_val_samples]
        val_targets = y[i*num_val_samples:(i+1)*num_val_samples]
        train_data = np.concatenate([x[:i*num_val_samples], 
                                   x[(i+1)*num_val_samples:]], axis=0)
        train_targets = np.concatenate([y[:i*num_val_samples], 
                                      y[(i+1)*num_val_samples:]], axis=0)
        
        # Build model
        model = Sequential()
        # Conv blocks
        for conv_idx in range(params['num_conv_layers']):
            conv_num = conv_idx + 1
            conv_args = {
                'filters': params[f'conv{conv_num}_filters'],
                'kernel_size': (3, 3),
                'padding': params[f'conv{conv_num}_padding'],
                'activation': 'relu',
                'kernel_regularizer': tf.keras.regularizers.l2(1e-4) if params[f'conv{conv_num}_l2'] else None,
            }
            if conv_idx == 0:
                conv_args['input_shape'] = x.shape[1:]
            
            model.add(Conv2D(**conv_args))
            if params[f'conv{conv_num}_batchnorm']:
                model.add(BatchNormalization())
            model.add(MaxPooling2D(2, 2))
            model.add(Dropout(params['global_dropout']))
        
        model.add(Flatten())
        
        # Dense blocks
        for dense_idx in range(params['num_dense_layers']):
            dense_num = dense_idx + 1
            model.add(Dense(
                units=params[f'dense{dense_num}_units'],
                activation='relu',
                kernel_regularizer=tf.keras.regularizers.l2(1e-4)
            ))
            if params[f'dense{dense_num}_batchnorm']:
                model.add(BatchNormalization())
            model.add(Dropout(params[f'dense{dense_num}_dropout']))
        
        model.add(Dense(3, activation='softmax'))
        
        # Compile and train
        model.compile(
            optimizer=tf.keras.optimizers.Adam(learning_rate=params['learning_rate']),
            loss='categorical_crossentropy',
            metrics=['accuracy']
        )
        
        history = model.fit(
            train_data, train_targets,
            validation_data=(val_data, val_targets),
            epochs=num_epochs,
            batch_size=params['batch_size'],
            callbacks=[early_stopping],
            verbose=1
        )
        val_acc_list.append(max(history.history['val_accuracy']))
    
    avg_val_acc = np.mean(val_acc_list)
    print(f"Validation Accuracy: {avg_val_acc:.4f}")
    return -avg_val_acc

# Run optimization
if __name__ == "__main__":
    result = gp_minimize(
        objective,
        space,
        n_calls=50,
        random_state=42,
        verbose=True
    )
    
    # Save best parameters
    best_params = {dim.name: val for dim, val in zip(space, result.x)}
    with open(os.path.join(sys.argv[1], 'best_params.pickle'), 'wb') as f:
        pickle.dump(best_params, f)