import pickle
import numpy as np
import matplotlib.pyplot as plt
import os
import sys
import tensorflow as tf
from datetime import datetime
from tensorflow.keras.callbacks import TensorBoard, EarlyStopping
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import (
    Conv2D, MaxPooling2D, Dense, Dropout,
    BatchNormalization, Flatten
)

# Set up TensorBoard logs
log_dir = os.path.join('logs', datetime.now().strftime("%Y%m%d-%H%M%S"))

# Load data
data_dir = os.path.join(sys.argv[1], 'data')
with open(os.path.join(data_dir, "x.pickle"), "rb") as f:
    x = pickle.load(f)
with open(os.path.join(data_dir, "y.pickle"), "rb") as f:
    y = pickle.load(f)

# Load best hyperparameters
with open(os.path.join(sys.argv[1], 'best_params.pickle'), 'rb') as f:
    best_params = pickle.load(f)

# Infer number of classes from y
num_classes = y.shape[1]

# Build final model
model = Sequential()

for conv_idx in range(best_params['num_conv_layers']):
    conv_num = conv_idx + 1

    # First conv layer gets the input_shape; others do not
    if conv_idx == 0:
        model.add(Conv2D(
            filters=best_params[f'conv{conv_num}_filters'],
            kernel_size=(3, 3),
            padding=best_params[f'conv{conv_num}_padding'],
            activation='relu',
            kernel_regularizer=(
                tf.keras.regularizers.l2(1e-4)
                if best_params[f'conv{conv_num}_l2'] else None
            ),
            input_shape=x.shape[1:]
        ))
    else:
        model.add(Conv2D(
            filters=best_params[f'conv{conv_num}_filters'],
            kernel_size=(3, 3),
            padding=best_params[f'conv{conv_num}_padding'],
            activation='relu',
            kernel_regularizer=(
                tf.keras.regularizers.l2(1e-4)
                if best_params[f'conv{conv_num}_l2'] else None
            )
        ))

    # Optional batch‐norm, then pooling and dropout
    if best_params[f'conv{conv_num}_batchnorm']:
        model.add(BatchNormalization())
    model.add(MaxPooling2D(pool_size=(2, 2)))
    model.add(Dropout(best_params['global_dropout']))

model.add(Flatten())

for dense_idx in range(best_params['num_dense_layers']):
    dense_num = dense_idx + 1
    model.add(Dense(
        units=best_params[f'dense{dense_num}_units'],
        activation='relu',
        kernel_regularizer=tf.keras.regularizers.l2(1e-4)
    ))
    if best_params[f'dense{dense_num}_batchnorm']:
        model.add(BatchNormalization())
    model.add(Dropout(best_params[f'dense{dense_num}_dropout']))

# Final classification layer
model.add(Dense(num_classes, activation='softmax'))

# Compile
model.compile(
    optimizer=tf.keras.optimizers.Adam(learning_rate=best_params['learning_rate']),
    loss='categorical_crossentropy',
    metrics=['accuracy']
)

# Callbacks
early_stopping = EarlyStopping(patience=10, restore_best_weights=True)
tensorboard_cb = TensorBoard(log_dir=log_dir)

# Train
num_epochs = 100
history = model.fit(
    x, y,
    epochs=num_epochs,
    batch_size=best_params['batch_size'],
    validation_split=0.2,
    callbacks=[early_stopping, tensorboard_cb],
    verbose=1
)

# Save model
model.save(os.path.join(sys.argv[1], 'burn_multiple_class.model'))

# Save plots
output_dir = os.path.join(sys.argv[1], 'output')
os.makedirs(output_dir, exist_ok=True)

# Accuracy plot
if 'accuracy' in history.history and 'val_accuracy' in history.history:
    plt.plot(history.history['accuracy'], label='Training accuracy')
    plt.plot(history.history['val_accuracy'], label='Validation accuracy')
    plt.title('Training and Validation Accuracy')
    plt.legend()
    plt.savefig(os.path.join(output_dir, 'final_accuracy.png'))
    plt.close()

# Loss plot
if 'loss' in history.history and 'val_loss' in history.history:
    plt.plot(history.history['loss'], label='Training loss')
    plt.plot(history.history['val_loss'], label='Validation loss')
    plt.title('Training and Validation Loss')
    plt.legend()
    plt.savefig(os.path.join(output_dir, 'final_loss.png'))
    plt.close()
